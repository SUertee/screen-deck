{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreenDeck project identity and private history records",
  "description": "应用随附项目身份、项目历史清单、任务与执行记录契约；只读校验不构成执行授权。",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/project_identity"
    },
    {
      "$ref": "#/$defs/project_history"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/run"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "path",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "id",
        "description",
        "verification",
        "requires_human"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "verification": {
          "enum": [
            "not_checked",
            "verified",
            "failed"
          ]
        },
        "requires_human": {
          "type": "boolean"
        }
      }
    },
    "executor": {
      "type": "object",
      "required": [
        "agent",
        "model",
        "effort",
        "metadata_source"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 150
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "metadata_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "schema_version",
        "project_id",
        "kind",
        "name",
        "created_at",
        "timezone",
        "mode",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_id": {
          "type": "string",
          "pattern": "^project-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "const": "project"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Shanghai"
        },
        "mode": {
          "const": "manual_pilot"
        },
        "references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "schema_version",
        "project_id",
        "kind",
        "task_id",
        "title",
        "goal",
        "status",
        "plan_version",
        "assignee",
        "created_at",
        "updated_at",
        "run_ids",
        "acceptance",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_id": {
          "type": "string",
          "pattern": "^project-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "running",
            "awaiting_approval",
            "verifying",
            "awaiting_review",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "assignee": {
          "enum": [
            "human",
            "agent",
            "shared"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^run-[0-9]{8}-[0-9]{3,}$"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "schema_version",
        "project_id",
        "kind",
        "task_id",
        "run_id",
        "plan_version",
        "status",
        "started_at",
        "ended_at",
        "recorded_at",
        "executor",
        "skills",
        "summary",
        "references",
        "git"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_id": {
          "type": "string",
          "pattern": "^project-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "const": "run"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task-[0-9]{3,}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run-[0-9]{8}-[0-9]{3,}$"
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "executor": {
          "$ref": "#/$defs/executor"
        },
        "skills": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "git": {
          "$ref": "#/$defs/git"
        }
      }
    },
    "git": {
      "type": "object",
      "required": [
        "commit_status",
        "commit_ids",
        "push_status"
      ],
      "additionalProperties": false,
      "properties": {
        "commit_status": {
          "enum": [
            "none",
            "committed",
            "unknown"
          ]
        },
        "commit_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        },
        "push_status": {
          "enum": [
            "not_pushed",
            "pushed",
            "unknown"
          ]
        }
      }
    },
    "project_identity": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "name",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "project"
        },
        "project_id": {
          "type": "string",
          "pattern": "^project-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "project_history": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "source_root",
        "created_at",
        "project",
        "migration"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "project_history"
        },
        "project_id": {
          "type": "string",
          "pattern": "^project-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "migration": {
          "type": "object",
          "required": [
            "backup_path",
            "migrated_at"
          ],
          "additionalProperties": false,
          "properties": {
            "backup_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "migrated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
