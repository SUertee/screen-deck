{
  "name": "screendeck-desktop",
  "version": "0.2.0-preview.1",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "setup:electron": "install-electron",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run setup:electron && npm run build && npm start",
    "test": "node scripts/test.mjs",
    "package:mac": "npm run setup:electron && npm run build && node scripts/package-mac.mjs",
    "smoke": "npm run setup:electron && npm run build && node scripts/smoke.mjs",
    "smoke:layout": "npm run setup:electron && npm run build && node scripts/layout-smoke.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "@iarna/toml": "2.2.5",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": { "node": ">=22.12.0" }
}
